# Firebase web app config.
#
#   cp .env.example .env.local     then fill in the values below
#
# Where to find them:
#   Firebase console -> gear -> Project settings -> General
#     -> Your apps -> Web app -> SDK setup and configuration -> Config
#
# The console gives you a JS object with camelCase keys. They map onto the
# names below one-to-one -- apiKey -> VITE_FIREBASE_API_KEY, and so on.
#
# Format: no quotes, no spaces around "=", no trailing commas.
#
# These are NOT secrets -- they ship in the client bundle. Firestore rules are
# what actually protect your data. Still, .env.local is gitignored: keep
# staging and production values apart.

# apiKey
VITE_FIREBASE_API_KEY=
# authDomain            e.g. your-project.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=
# projectId
VITE_FIREBASE_PROJECT_ID=
# storageBucket         e.g. your-project.firebasestorage.app (unused for now, kept for parity)
VITE_FIREBASE_STORAGE_BUCKET=
# messagingSenderId     the numeric project number
VITE_FIREBASE_MESSAGING_SENDER_ID=
# appId                 e.g. 1:123456789:web:abc123
VITE_FIREBASE_APP_ID=

# Point the app at local emulators instead of live Firebase.
VITE_USE_FIREBASE_EMULATORS=false
